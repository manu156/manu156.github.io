---
import type { HTMLTag } from "astro/types";

interface Props {
  level: number;
  id: string;
}

const { level, id } = Astro.props;
const Tag: HTMLTag = `h${level}` as HTMLTag;
const shouldAddBeforePseudoStyle = ["h1", "h2"].includes(Tag);
---

<Tag id={id} class="group flex">
  {
    shouldAddBeforePseudoStyle ? (
      <span class="pl-6 relative block leading-[150%] before:absolute before:content-[''] before:w-2 before:h-full before:top-0 before:left-0 before:bg-primary-green">
        <slot />
      </span>
    ) : (
      <span class="relative block leading-[150%]">
        <slot />
      </span>
    )
  }
</Tag>
